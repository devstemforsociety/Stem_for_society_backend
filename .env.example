# ---------------------------------------------------------------- Runtime
# Set to "production" on deployed environments. It switches off SQL query
# logging and developer tracing, both of which write customer data to logs.
NODE_ENV=development
PORT=3001

# Comma-separated list of frontend origins allowed to call this API.
# REQUIRED in production - while it is unset the API accepts requests from any
# origin and logs a warning at startup.
#   ALLOWED_ORIGINS=https://stemforsociety.com,https://www.stemforsociety.com
ALLOWED_ORIGINS=

# ---------------------------------------------------------------- Database
DB_MODE=local
DB_URL_LOCAL=
DB_URL_PROD=

# --------------------------------------------------------------------- Auth
# One signing secret per role, so a stolen token for one role cannot be
# replayed against another. Generate 32+ random bytes each, never a passphrase:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating these invalidates every existing session.
AUTH_SECRET_STU=
AUTH_SECRET_PT=
AUTH_SECRET_AD=

# ----------------------------------------------------------------- Payments
# "test" uses the RZPY_TEST_* pair, anything else uses RZPY_LIVE_*.
PAYMENT_MODE=test
RZPY_TEST_KEYID=
RZPY_TEST_KEYSEC=
RZPY_LIVE_KEYID=
RZPY_LIVE_KEYSEC=
# From the Razorpay dashboard webhook settings; must match exactly.
RZPY_WH_SECRET=

# ----------------------------------------------------------------- Supabase
SUPABASE_DB_PWD=
SUPABASE_PROJECT_URL=
SUPABASE_SERVICE_KEY=

# -------------------------------------------------------------------- Email
EMAIL=
APP_PASS=

# ------------------------------------------------------- Optional services
# Cloudinary powers partner logo/signature upload and delete. Leave blank to
# disable those two endpoints; the rest of the API is unaffected.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis and the certificate queue are currently unused - every producer and the
# worker are commented out. Leave blank unless you re-enable certificates.
REDIS_MODE=
REDIS_URI_LOCAL=
REDIS_URI_PROD=
QUEUE_NAME_CERT=

# --- Sentry (server) ------------------------------------------------------
# Leave SENTRY_DSN empty to disable reporting entirely; the API runs exactly
# the same, it just records nothing. This must be the DSN of a Node project,
# not the browser one - platform, grouping and quota are per project.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Share of requests traced in production. 0.1 = 10%.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Ties an event to a build, e.g. the git sha.
SENTRY_RELEASE=
